# ============================================
# Mentora — Production (.env for docker-compose.prod.yml)
# ============================================
# Copy to .env on the server:
#   cp .env.production.example .env
# Then replace every CHANGE_ME value before first deploy.
# ============================================

# --- HTTP ---
HTTP_PORT=80

# --- Docker images (built by GitHub Actions, pulled on server) ---
API_IMAGE=ghcr.io/cosmin1994p/mentora-api:latest
FRONTEND_IMAGE=ghcr.io/cosmin1994p/mentora-frontend:latest
# Pin a release: IMAGE_TAG=v1.0.0  (set both images to :v1.0.0)

# --- MongoDB (internal only — not exposed to the internet) ---
# Root user: admin operations / restore only (not used by the app)
MONGO_ROOT_USER=mentora_root
MONGO_ROOT_PASSWORD=CHANGE_ME_root_password_min_16_chars

# App user: used by the API container (readWrite on masterclass DB)
MONGO_APP_USER=mentora_app
MONGO_APP_PASSWORD=CHANGE_ME_app_password_min_16_chars
MONGO_DATABASE=masterclass

# --- API ---
JWT_SECRET=CHANGE_ME_long_random_jwt_secret
ADMIN_USERNAME=admintudy
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Backblaze B2 (outbound from api container) ---
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-application-key
B2_BUCKET_NAME=mentora
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_CDN_URL=https://cdn.mentora.page/file/mentora

# --- One-time restore (optional overrides) ---
# RESTORE_ARCHIVE=/dump/masterclass.archive
# RESTORE_GZIP=false

# --- ML service (disabled in v1 — enable later) ---
# DISABLE_ML_SERVER=false
# ML_API_URL=http://ml-api:5001/api
