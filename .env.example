# ============================================
# Mentora Platform - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# MongoDB Configuration
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@your-cluster.mongodb.net/mentora?retryWrites=true&w=majority
# MONGO_URI is also supported for compatibility with docker-compose.yml.

# Backblaze B2 Configuration (for video storage & streaming)
B2_BUCKET=your-bucket-name
B2_APP_KEY_ID=your-app-key-id
B2_APP_KEY=your-app-key

# JWT Secret (generate a strong random key for production)
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# API Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
