# ML Recommendation Engine - Environment Configuration
# Copy this file to .env.ml and fill in your actual values

# ============================================================================
# MongoDB Configuration
# ============================================================================

# MongoDB connection URI
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB_NAME=streamclass

# Connection timeout (milliseconds)
MONGODB_TIMEOUT=5000

# ============================================================================
# Flask API Configuration
# ============================================================================

# Flask environment
FLASK_ENV=development
# Set to 'production' for deployment

# Flask host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Flask debug mode
FLASK_DEBUG=True
# Set to False in production

# ============================================================================
# Recommendation Engine Configuration
# ============================================================================

# Number of recommendations to return by default
DEFAULT_RECOMMENDATIONS=5

# Maximum recommendations allowed per request
MAX_RECOMMENDATIONS=20

# Cache TTL in hours
CACHE_TTL_HOURS=24

# ============================================================================
# Mood Weights Configuration
# ============================================================================

# Default mood weights (must sum to 1.0)
MOOD_WEIGHT=0.35
PERSONALIZATION_WEIGHT=0.25
SIMILARITY_WEIGHT=0.15
POPULARITY_WEIGHT=0.15
DIVERSITY_WEIGHT=0.05
RECENCY_WEIGHT=0.05

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=ml_recommendation.log

# ============================================================================
# Feature Flags
# ============================================================================

# Enable recommendations caching
ENABLE_CACHE=True

# Enable interaction logging
ENABLE_INTERACTION_LOGGING=True

# Enable collaborative filtering (advanced)
ENABLE_COLLABORATIVE_FILTERING=False
